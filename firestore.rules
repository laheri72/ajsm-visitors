rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Visitors
    match /visitors/{id} {
      allow read: if request.auth != null
        && (
          request.auth.token.email == "admin@ajsm.edu"
          || request.auth.token.email == "desk@ajsm.edu"
        );

      allow update: if request.auth != null
        && (
          request.auth.token.email == "admin@ajsm.edu"
          || request.auth.token.email == "desk@ajsm.edu"
        );

      // Enforce mandatory fields on visitor creation (data barricading)
      allow create: if request.resource.data.keys().hasAll(['name', 'mobile', 'email', 'purpose', 'scheduledDate', 'scheduledTime', 'status'])
        && request.resource.data.status == "scheduled"
        && request.resource.data.name is string
        && request.resource.data.mobile is string
        && request.resource.data.email is string;

      // Delete only allowed for admin AND only if the visit is NOT completed (checked-out)
      allow delete: if request.auth != null
        && request.auth.token.email == "admin@ajsm.edu"
        && resource.data.status != "checked-out"
        && resource.data.status != "checked-in";
    }

    // Dynamic Institutional Policy Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "admin@ajsm.edu";
    }

    // Visitor 24-Hour Barricade Locks
    match /visitor_barricades/{barricadeId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['type', 'value', 'visitorId', 'expiresAt']);
    }

    // Mail Queue (Trigger Email Extension)
    match /mail/{mailId} {
      allow create: if request.resource.data.keys().hasAll(['to', 'message']);
      allow read: if request.auth != null;
    }

    // Cards
    match /cards/{cardId} {
      allow read: if request.auth != null
        && (
          request.auth.token.email == "admin@ajsm.edu"
          || request.auth.token.email == "desk@ajsm.edu"
        );

      // Admin: full control
      allow update: if request.auth != null
        && request.auth.token.email == "admin@ajsm.edu";

      // Desk: LIMITED update (release only)
      allow update: if request.auth != null
        && request.auth.token.email == "desk@ajsm.edu"
        && request.resource.data.status == "available"
        && request.resource.data.assignedTo == null;

      allow create: if request.auth != null
        && (
          request.auth.token.email == "admin@ajsm.edu"
          || request.auth.token.email == "desk@ajsm.edu"
        );

      allow delete: if false;
    }

    // Counters
    match /counters/{counterId} {
      allow read: if request.auth != null
        && (
          request.auth.token.email == "admin@ajsm.edu"
          || request.auth.token.email == "desk@ajsm.edu"
        );

      allow update: if request.auth != null
        && (
          request.auth.token.email == "admin@ajsm.edu"
          || request.auth.token.email == "desk@ajsm.edu"
        );
    }
  }
}